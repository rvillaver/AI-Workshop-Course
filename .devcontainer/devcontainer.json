{
  "name": "AI Workshop — demos & dev environment",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",
  "forwardPorts": [4000],
  "portsAttributes": {
    "4000": { "label": "Triage Board", "onAutoForward": "notify" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "secrets": {
    "OPENROUTER_API_KEY": {
      "description": "Your own free OpenRouter API key (https://openrouter.ai/keys). Powers the agent demos; each attendee brings their own."
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["anthropic.claude-code"]
    }
  }
}
